#!/bin/bash
shopt -qs extglob

getShortUsage()
{
    local compareOp='-g|--greater|-s|--smaller|-lt|-le|-eq|-ne|-ge|-gt NUM'
    local usageSep
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local hadTopic=
	case "$1" in
	    ''|filter)
		fieldMap --get-short-usage filter; hadTopic=t;;&
	    ''|config)
		printf %s "${usageSep}${hadTopic:+ }" '[--non-numeric zero|keep|drop]'; hadTopic=t;;&
	    compare-op)
		printf %s "${usageSep}${hadTopic:+ }" "$compareOp"; hadTopic=t;;&
	    ''|compare-expr)
		printf %s "${usageSep}${hadTopic:+ }" "([-]N $compareOp) [...]"; hadTopic=t;;&
	    file)
		fieldMap --get-short-usage file; hadTopic=t;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown short usage topic \"$1\"!" >&2; return 2; };;
	esac
	shift; usageSep=' '
    done
}
getLongUsage()
{
    [ $# -gt 0 ] || set -- ''
    while [ $# -gt 0 ]
    do
	local topic="$1"; shift
	local hadTopic=
	case "$topic" in
	    ''|filter)
		fieldMap --get-long-usage filter
		hadTopic=t
		;;&
	    ''|config)
		cat <<HELPTEXT
    --non-numeric zero	Treat non-numeric values as 0 for comparison purposes.
			This is the default.
    --non-numeric keep	A comparison against a non-numeric value will always
			succeed and the line will be kept.
    --non-numeric drop	A comparison against a non-numeric value will always
			fail and the line will be dropped.
HELPTEXT
		hadTopic=t
		;;&
	    compare-op)
		local action="${1?}"; shift
		cat <<HELPTEXT
    -g|--greater|-s|--smaller|-lt|-le|-eq|-ne|-ge|-gt NUM
			Only ${action:-print those lines where the numeric value}
			compares successfully to NUM. A single successful
			comparison is enough (i.e. it works like grep).
HELPTEXT
		hadTopic=t
		;;&
	    ''|compare-expr)
		cat <<HELPTEXT
    [-]N -g|--greater|-s|--smaller|-lt|-le|-eq|-ne|-ge|-gt NUM
			Only print those lines where the numeric value in field
			N (-N counted from behind) compares to NUM. A single
			successful comparison is enough to print a line (i.e. it
			works like grep).
HELPTEXT
		hadTopic=t
		;;&
	    *)  [ "$hadTopic" ] || { echo "ERROR: Unknown long usage topic \"$topic\"!" >&2; return 2; };;
	esac
    done
}
printShortUsage()
{
    # Note: short followed by long option; if the user knows the short one, they can
    # skim the long one.
    printf 'Usage: cat FILE [...] | %q %s\n' "$(basename "$1")" "$(getShortUsage '')"
    printf 'Usage: %q %s\n' "$(basename "$1")" "... $(getShortUsage file) $(getShortUsage compare-expr) [--] FILE [...] [-?|-h|--help]"
}
printUsage()
{
    # This is the short help when launched with no or incorrect arguments.
    # It is printed to stderr to avoid accidental processing.
    printShortUsage "$1" >&2
    printf >&2 '\nTry %q --help for more information.\n' "$(basename "$1")"
}
printLongUsage()
{
    # This is the long "man page" when launched with the help argument.
    # It is printed to stdout to allow paging with 'more'.
    cat <<HELPDESCRIPTION
Filter lines based on numeric comparison(s) of field(s).
HELPDESCRIPTION
    echo
    printShortUsage "$1"
    echo
    getLongUsage ''
    cat <<HELPTEXT
SEE ALSO:
- fieldMap is the generic underlying engine that can both filter and transform
  fields.

EXIT STATUS:
    0	Complete success.
    1	AWK processing error.
    2	Bad invocation, wrong or missing command-line arguments.
    3	Internal error or failed assertion.

Example:
HELPTEXT
    printf 'ls -l / | %q %s\n' "$(basename "$1")" '2 -gt 1'
}

typeset -a comparisons=()
storeComparison()
{
    local fieldNum="${1:?}"; shift
    local value="${1:?}"; shift
    local comparison="${1:?}"; shift
    comparisons+=("if (comparisons[${fieldNum}][${value}] == \"\") { comparisons[${fieldNum}][${value}]=\"${comparison}\"; } else { printf(\"ERROR: Value %d already given in -%s comparison for field %d.\\n\", $value, comparisons[${fieldNum}][${value}], $fieldNum) > \"/dev/stderr\"; exit 2; }")
}
addComparison()
{
    local fieldNum="${1:?}"; shift
    case "$1" in
	--greater|-g)	    storeComparison "$fieldNum" "${2:?}" gt;;
	--smaller|-s)	    storeComparison "$fieldNum" "${2:?}" lt;;
	-@([gl][et]|eq|ne)) storeComparison "$fieldNum" "${2:?}" "${1#-}";;
	*)		    { echo "ERROR: Unknown comparison operator \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
    esac; shift
}

typeset -a fieldMapArgs=()
option() { :; }
parameter() { :; }
parameterToSep() { :; }
argCount() { :; }
endOfOptionsAndParameters() { :; }
noUnderstand() { :; }
compareOp() { :; }
typeset -A understandsSubtopics=()
isUnderstandSubtopic() {
    [ $# -gt 0 -a ${#understandsSubtopics[@]} -gt 0 ] || return 0
    local subtopic; for subtopic
    do
	[ "${understandsSubtopics["$subtopic"]}" ] && return 0
    done
    return 1
}
while [ $# -ne 0 ]
do
    case "$1" in
	--help|-h|-\?)	shift; printLongUsage "$0"; exit 0;;
	--get-short-usage)
			shift; getShortUsage "$@"; exit $?;;
	--get-long-usage)
			shift; getLongUsage "$@"; exit $?;;
	--understand-for)
			shift; understandsSubtopics["$1"]=t; shift;;
	--understands)	shift
			option() { isUnderstandSubtopic "$@" || exit 1; printf 1; exit 0; }
			parameter() { isUnderstandSubtopic "$@" || exit 1; printf 2; exit 0; }
			parameterToSep() { argCount "$@"; }
			argCount() { local argCount="${1:?}"; shift; isUnderstandSubtopic "$@" || exit 1; printf $argCount; exit 0; }
			endOfOptionsAndParameters() { exit 99; }
			noUnderstand() { exit 1; }
			compareOp() {
			    if isUnderstandSubtopic compare-op; then
				addComparison 0 "$1" "$2" 2>/dev/null \
				    && { printf 2; exit 0; } \
				    || exit 1
			    else
				exit 1
			    fi
			}
			;;

	-+([u]))	fieldMapArgs+=("$1"); shift; option filter;;
	--@(unbuffered))
			fieldMapArgs+=("$1"); shift; option filter;;
	-[F])		fieldMapArgs+=("$1" "${2?}"); shift; shift; option filter;;
	--@(field-separator))
			fieldMapArgs+=("$1" "${2?}"); shift; shift; option filter;;
	--non-numeric)	shift; fieldMapArgs+=(--assign "nonNumericMode=${1:?}"); shift; parameter config;;
	?(-)+([0-9]))	addComparison "$1" "${2:?}" "${3:?}"; shift; shift; shift; argCount 3 compare-expr;;
	--)		endOfOptionsAndParameters; break;;
	-*)		compareOp "$@"; { echo "ERROR: Unknown option \"$1\"!"; echo; printUsage "$0"; } >&2; exit 2;;
	*)		endOfOptionsAndParameters; break;;
    esac
done
if [ ${#comparisons[@]} -eq 0 ]; then
    echo 'ERROR: No comparison(s) passed.'
    echo
    printUsage "$0"
    exit 2
fi >&2

IFS=$'\n'
exec fieldMap "${fieldMapArgs[@]}" --function 'filterField(fieldValue, fieldComparisons,      isMatch, n, i, previousComparison, comparison, comparisonValue, isCurrentMatch, isOpen, isOpening) {
    isMatch = 0
    n = asorti(fieldComparisons, fieldComparisonsSortedValues, "@ind_num_asc")

    # Check for equality first; if we have a match, we can directly accept the line.
    # But more importantly, in the second loop, the intermingling of -eq and -ne would disrupt the opening/closing logic.
    for (i = 1; i <= n; i++) {
	comparison = fieldComparisons[fieldComparisonsSortedValues[i]]
	comparisonValue = fieldComparisonsSortedValues[i]
	if (comparison == "eq") {
	    isCurrentMatch = (fieldValue == comparisonValue)
	    if (index("," ENVIRON["DEBUG"] ",", ",fieldFilterNumber,")) print "**** #" fieldNr " (" i "): " fieldValue " -" comparison " (" previousComparison ") " comparisonValue > (ENVIRON["BATS_TEST_NAME"] ? "/dev/fd/3" : "/dev/stderr")
	    if (index("," ENVIRON["DEBUG"] ",", ",fieldFilterNumber,")) print "****" (isCurrentMatch ? " accepted" : " not-matching") > (ENVIRON["BATS_TEST_NAME"] ? "/dev/fd/3" : "/dev/stderr")
	    if (isCurrentMatch) return 1
	}
    }

    for (i = 1; i <= n; i++) {
	comparison = fieldComparisons[fieldComparisonsSortedValues[i]]
	comparisonValue = fieldComparisonsSortedValues[i]
	if (comparison == "eq") continue    # Already handled in the first loop above.

	if (index("," ENVIRON["DEBUG"] ",", ",fieldFilterNumber,")) print "**** #" fieldNr " (" i "): " fieldValue " -" comparison " (" previousComparison ") " comparisonValue > (ENVIRON["BATS_TEST_NAME"] ? "/dev/fd/3" : "/dev/stderr")
	switch (comparison) {
	    case "gt": {
		isOpening = 1
		if (previousComparison == "gt" || previousComparison == "ge") continue # Already compared against a smaller value.
		isCurrentMatch = (fieldValue > comparisonValue)
		break
	    }
	    case "ge": {
		isOpening = 1
		if (previousComparison == "gt" || previousComparison == "ge") continue # Already compared against a smaller value.
		isCurrentMatch = (fieldValue >= comparisonValue)
		break
	    }
	    case "ne": {
		isOpening = 1
		isCurrentMatch = (fieldValue != comparisonValue)
		break
	    }

	    case "lt": {
		isOpening = 0
		if (previousComparison == "lt" || previousComparison == "le") continue # Already compared against a smaller value.
		isCurrentMatch = (fieldValue < comparisonValue)
		break
	    }
	    case "le": {
		isOpening = 0
		if (previousComparison == "lt" || previousComparison == "le") continue # Already compared against a smaller value.
		isCurrentMatch = (fieldValue <= comparisonValue)
		break
	    }

	    default: {
		exit(3)
	    }
	}
	if (index("," ENVIRON["DEBUG"] ",", ",fieldFilterNumber,")) print "****" (isOpen ? " open  " : " closed") (isOpening ? " opening" : " closing") (isMatch ? "    match" : " no-match") (isCurrentMatch ? "     matching" : " not-matching") > (ENVIRON["BATS_TEST_NAME"] ? "/dev/fd/3" : "/dev/stderr")
	if (isOpen) {
	    # The last comparison was an opening one; following comparisons also need to
	    # match until we encounter a closing one.
	    isMatch = isMatch && isCurrentMatch
	} else if (i > 1 && isMatch) {
	    # We had a match and are not open; accept the line.
	    if (index("," ENVIRON["DEBUG"] ",", ",fieldFilterNumber,")) print "**** accepted" > (ENVIRON["BATS_TEST_NAME"] ? "/dev/fd/3" : "/dev/stderr")
	    return 1
	} else {
	    isMatch = isMatch || isCurrentMatch
	}
	isOpen = isOpening
	previousComparison = comparison
    }

    if (index("," ENVIRON["DEBUG"] ",", ",fieldFilterNumber,")) print "****" (isMatch ? " accepted" : " declined") > (ENVIRON["BATS_TEST_NAME"] ? "/dev/fd/3" : "/dev/stderr")
    return isMatch
}
function isNumber(x) {
    return (x + 0 == x)
}
function fieldFilter(      fieldNr, fieldValue, isMatch) {
    isMatch = 0
    for (fieldNr in comparisons) {
	fieldValue = $getFieldNr(fieldNr, NF)

	if (! isNumber(fieldValue)) {
	    switch (nonNumericMode) {
		case "":
		case "zero": fieldValue = 0; break
		case "keep": return 1; break
		case "drop": return 0; break
		default: printf("ASSERT: Invalid nonNumericMode: %s\n", nonNumericMode) > "/dev/stderr"; exit 3
	    }
	}

	isMatch = isMatch || filterField(fieldValue, comparisons[fieldNr])
    }
    return isMatch
}
BEGIN {
'"${comparisons[*]}"'
}
' \
    --filter 'fieldFilter()' "$@"
