#!/usr/bin/env bats

load fixture

@test "greater than comparison filters everything after the first record" {
    run -0 fieldFilterNumber -F $'\t' 1 -gt 25 <<'EOF'
26	2026-07-31 18:00	2026-08-26 21:00
3	2026-07-20 20:15	2026-07-23 21:00
3	2026-07-13 17:45	2026-07-16 20:45
3	2026-07-07 16:30	2026-07-10 22:00
8	2026-05-17 15:00	2026-05-25 20:00
3	2026-03-31 18:45	2026-04-03 20:15
4	2026-03-23 18:30	2026-03-27 20:15
3	2026-03-16 19:00	2026-03-19 16:30
3	2026-02-17 19:00	2026-02-20 20:15
4	2026-01-01 18:45	2026-01-05 16:45
EOF
    assert_output '26	2026-07-31 18:00	2026-08-26 21:00'
}
